{
  "name": "delivrery-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "deLIVREry - Logística Livre e Descentralizada",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@delivrery/pwa",
    "dev:portal": "npm run dev --workspace=@delivrery/developer-portal",
    "test": "node --experimental-strip-types --test tests/*.test.js",
    "test:schema": "node tests/schema-validation.test.js",
    "build:widget": "npm run build --workspace=@delivrery/embed-widget"
  },
  "keywords": [
    "delivery",
    "logistica-livre",
    "open-source",
    "monorepo",
    "supabase"
  ],
  "author": "deLIVREry Community",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
