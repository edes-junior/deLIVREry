# ==============================================================================
# deLIVREry - Environment Configuration Template
# ==============================================================================

# Supabase Local / Remote
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=anon-key-placeholder

# PIX Community Donation Configuration (Epic 4 / Story 4.1 - FR-11)
PUBLIC_PIX_KEY=apoio@delivrery.org
PUBLIC_PIX_RECIPIENT_NAME=Comunidade deLIVREry
PUBLIC_PIX_CITY=SAO PAULO
# PUBLIC_PIX_BRCODE_PAYLOAD= (opcional: se definido, substitui a geração automática de BR Code)

# Equivalentes prefixados com VITE_ para bundling do PWA
VITE_PUBLIC_PIX_KEY=apoio@delivrery.org
VITE_PUBLIC_PIX_RECIPIENT_NAME=Comunidade deLIVREry
VITE_PUBLIC_PIX_CITY=SAO PAULO
# VITE_PUBLIC_PIX_BRCODE_PAYLOAD=

# ==============================================================================
# Epic 5: Headless API, Webhooks & Production Secrets (CI/CD Deploy)
# ==============================================================================
# Chave mestra de serviço do Supabase (para rotas headless e triggers assíncronos)
SUPABASE_SERVICE_ROLE_KEY=service-role-key-secret-placeholder

# Salt criptográfico para hashing irreversível de API Keys de parceiros B2B
DELIVRERY_API_KEY_SALT=delivrery_secret_salt_hash_production_value_change_me

# Salt opcional para geração de segredos de webhooks HMAC-SHA256
WEBHOOK_SIGNING_SECRET_SALT=delivrery_webhook_salt_production_placeholder

# Identificador do projeto no Supabase
SUPABASE_PROJECT_ID=iwffzklyzxtmkcecfcfq

# Configuração de CDN para o Web Component <delivrery-button />
PUBLIC_CDN_WIDGET_URL=https://cdn.delivrery.app.br/embed/v1/delivrery-button.js
VITE_PUBLIC_CDN_WIDGET_URL=https://cdn.delivrery.app.br/embed/v1/delivrery-button.js
